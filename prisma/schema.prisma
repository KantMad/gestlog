generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Season {
  id         String   @id @default(cuid())
  name       String
  year       Int
  type       String   // "AH" or "PE"
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clients            ClientSeason[]
  supplierOrders     SupplierOrder[]
  clientOrders       ClientOrder[]
  catalogs           Catalog[]
  allocationSessions AllocationSession[]
  imports            ImportLog[]

  @@unique([year, type])
}

model Client {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons      ClientSeason[]
  clientOrders ClientOrder[]
  deliveries   Delivery[]
}

model ClientSeason {
  id                   String   @id @default(cuid())
  clientId             String
  seasonId             String
  ranking              Int      @default(5)
  maxReductionOrder    Float    @default(30.0)
  maxReductionLine     Float    @default(50.0)
  minDeliveryThreshold Int      @default(10)
  isActive             Boolean  @default(true)
  rotationScore        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([clientId, seasonId])
  @@index([seasonId])
  @@index([ranking])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierOrders     SupplierOrder[]
  receptions         SupplierReception[]
  supplierProductRefs SupplierProductRef[]
}

model Product {
  id          String   @id @default(cuid())
  reference   String
  color       String
  colorCode   String?
  externalId  String?  @unique // B2B product_id + color_id (e.g. "3119_53")
  sizeScale   String   // "XS,S,M,L,XL,XXL"
  category    String?  // catégorie BtoB (ex: "Pantalon")
  subCategory String?  // sous-catégorie BtoB (ex: "Pantalon 5 poches")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplierOrderLines SupplierOrderLine[]
  clientOrderLines   ClientOrderLine[]
  receptionLines     ReceptionLine[]
  stockEntries       StockEntry[]
  allocationLines    AllocationLine[]
  deliveryLines      DeliveryLine[]

  @@unique([reference, color])
  @@index([reference])
  @@index([externalId])
}

model ProductSizeEan {
  id        String @id @default(cuid())
  reference String
  color     String
  size      String
  ean       String @unique

  @@unique([reference, color, size])
  @@index([reference, color])
}

// Type de taille (ex: "A" = Standard Femme)
model SizeType {
  id        String   @id @default(cuid())
  code      String   @unique // ex: "A", "B", "C"
  label     String?  // ex: "Standard Femme"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings SizeTypeMapping[]
}

// Mapping : type de taille → numéro de taille → valeur taille
// Ex: type "A", position 1 → "XS" ; type "A", position 2 → "S" ; etc.
model SizeTypeMapping {
  id           String @id @default(cuid())
  sizeTypeId   String
  position     Int    // numéro de taille (1, 2, 3, 4...)
  sizeName     String // valeur taille ("XS", "S", "M", "L"...)

  sizeType SizeType @relation(fields: [sizeTypeId], references: [id], onDelete: Cascade)

  @@unique([sizeTypeId, position])
  @@unique([sizeTypeId, sizeName])
  @@index([sizeTypeId])
}

// Correspondance fournisseur ↔ référence produit
model SupplierProductRef {
  id           String   @id @default(cuid())
  supplierId   String
  reference    String
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, reference])
  @@index([reference])
}

model SupplierOrder {
  id          String    @id @default(cuid())
  orderNumber String
  seasonId    String
  supplierId  String
  orderDate   DateTime?
  status      String    @default("EN_ATTENTE") // EN_ATTENTE, PARTIEL, COMPLET, SOLDE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season     Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines      SupplierOrderLine[]
  receptions SupplierReception[]

  @@unique([orderNumber, seasonId])
  @@index([seasonId])
  @@index([supplierId])
}

model SupplierOrderLine {
  id               String   @id @default(cuid())
  supplierOrderId  String
  productId        String
  quantitiesBySize String   // JSON: {"S":10,"M":20}
  totalQuantity    Int
  createdAt        DateTime @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierOrderId, productId])
}

model SupplierReception {
  id              String   @id @default(cuid())
  receptionNumber String
  supplierOrderId String
  supplierId      String
  receptionDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines         ReceptionLine[]

  @@index([supplierOrderId])
}

model ReceptionLine {
  id                  String   @id @default(cuid())
  supplierReceptionId String
  productId           String
  quantitiesBySize    String   // JSON
  totalQuantity       Int
  createdAt           DateTime @default(now())

  supplierReception SupplierReception @relation(fields: [supplierReceptionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Catalog {
  id        String   @id @default(cuid())
  name      String   @unique
  seasonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clientOrders ClientOrder[]

  @@index([seasonId])
}

model ClientOrder {
  id              String    @id @default(cuid())
  orderNumber     String
  seasonId        String
  clientId        String
  catalogId       String?
  orderDate       DateTime?
  orderType       String    @default("COMMANDE") // COMMANDE or VSS
  status          String    @default("EN_COURS") // EN_COURS, VALIDEE, SOLDEE, ANNULEE
  deliveryWindow  String?   // ex: "S22-S26", fenêtre de livraison
  paymentStatus   String    @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REFUSE
  tioOrderNumber  String?   // Take In Order reference number
  deliveryDateStart DateTime?
  deliveryDateEnd   DateTime?
  totalAmount     Float?    // montant total commande
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  season  Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalog Catalog?        @relation(fields: [catalogId], references: [id])
  lines   ClientOrderLine[]

  @@unique([orderNumber, seasonId])
  @@index([seasonId])
  @@index([clientId])
  @@index([catalogId])
  @@index([status])
}

model ClientOrderLine {
  id               String   @id @default(cuid())
  clientOrderId    String
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  category         String?  // catégorie produit
  sizeTypeCode     String?  // code du type de taille (lien vers SizeType)
  createdAt        DateTime @default(now())

  clientOrder ClientOrder @relation(fields: [clientOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientOrderId, productId])
}

model StockEntry {
  id               String   @id @default(cuid())
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  importDate       DateTime @default(now())
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AllocationSession {
  id          String   @id @default(cuid())
  seasonId    String
  sessionDate DateTime @default(now())
  status      String   @default("SIMULATION") // SIMULATION, VALIDATED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season     Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  lines      AllocationLine[]
  deliveries Delivery[]

  @@index([seasonId])
  @@index([status])
}

model AllocationLine {
  id                  String   @id @default(cuid())
  allocationSessionId String
  clientOrderId       String?
  productId           String
  clientId            String?
  originalBySize      String   // JSON
  allocatedBySize     String   // JSON
  reducedBySize       String   // JSON
  reductionReason     String
  status              String   @default("LIVRABLE") // LIVRABLE, EN_ATTENTE, ANNULE
  isManualAdjustment  Boolean  @default(false)
  createdAt           DateTime @default(now())

  allocationSession AllocationSession @relation(fields: [allocationSessionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([allocationSessionId])
  @@index([productId])
}

model ShipmentGroup {
  id          String   @id @default(cuid())
  name        String   // ex: "PAMAZO S22"
  carrier     String?  // transporteur
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries Delivery[]
}

model Delivery {
  id                  String    @id @default(cuid())
  deliveryNumber      Int
  clientId            String
  clientOrderId       String?
  allocationSessionId String?
  shipmentGroupId     String?
  status              String    @default("PLANIFIEE") // PLANIFIEE, EN_PREPARATION, ENVOYEE_DEPOT, VALIDEE_DEPOT, EXPEDIEE
  colorCode           String
  eanExportGenerated  Boolean   @default(false)
  // Depot workflow fields
  nbColis             Int?
  nbPieces            Int?
  blNumber            String?   // numéro BL
  carrier             String?   // transporteur
  depotStatus         String?   // EN_ATTENTE, RECU, VALIDE, ANOMALIE
  comment             String?   // commentaire libre
  sentToDepotAt       DateTime?
  validatedAt         DateTime?
  shippedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  allocationSession AllocationSession?  @relation(fields: [allocationSessionId], references: [id])
  shipmentGroup     ShipmentGroup?      @relation(fields: [shipmentGroupId], references: [id])
  lines             DeliveryLine[]
  eanExports        EanExport[]

  @@index([clientId])
  @@index([status])
  @@index([shipmentGroupId])
}

model DeliveryLine {
  id               String   @id @default(cuid())
  deliveryId       String
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  createdAt        DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model EanExport {
  id          String   @id @default(cuid())
  deliveryId  String
  fileName    String
  exportData  String   // JSON array
  generatedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model ImportLog {
  id         String   @id @default(cuid())
  seasonId   String
  importType String   // CLIENT_ORDER, SUPPLIER_ORDER, RECEPTION, STOCK, SIZE_TYPE, SUPPLIER_REF, EAN
  fileName   String
  rowCount   Int
  errorCount Int      @default(0)
  errors     String?  // JSON
  importedAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  role         String   @default("USER") // ADMIN or USER
  isActive     Boolean  @default(true)
  screenAccess String?  // JSON array of allowed screen keys; null = all screens
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── BtoC (WooCommerce) — Données séparées du BtoB ──────────

model BtocCustomer {
  id            String   @id @default(cuid())
  wooId         Int      @unique  // WooCommerce customer ID
  email         String
  firstName     String
  lastName      String
  company       String?
  phone         String?
  billingPostcode String?
  billingCity   String?
  billingCountry String?
  shippingCity  String?
  shippingCountry String?
  totalSpent    Float    @default(0)
  ordersCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders BtocOrder[]

  @@index([email])
}

model BtocProduct {
  id            String   @id @default(cuid())
  wooId         Int      @unique  // WooCommerce product ID
  sku           String?
  name          String
  type          String   @default("simple") // simple, variable, variation
  parentId      Int?     // parent product ID for variations
  status        String   @default("publish")
  price         Float?
  regularPrice  Float?
  salePrice     Float?
  stockQuantity Int?
  stockStatus   String?  // instock, outofstock, onbackorder
  category      String?  // main category name
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderLines BtocOrderLine[]

  @@index([sku])
  @@index([parentId])
}

model BtocOrder {
  id              String    @id @default(cuid())
  wooId           Int       @unique  // WooCommerce order ID
  orderNumber     String
  status          String    // pending, processing, on-hold, completed, cancelled, refunded, failed
  customerId      String?
  customerEmail   String?
  customerName    String?
  billingCity     String?
  shippingCity    String?
  total           Float
  subtotal        Float?
  totalTax        Float?
  shippingTotal   Float?
  discountTotal   Float?
  paymentMethod   String?
  paymentTitle    String?
  currency        String   @default("EUR")
  itemCount       Int      @default(0)
  couponCodes     String?  // JSON array of coupon codes
  customerNote    String?
  orderDate       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer BtocCustomer? @relation(fields: [customerId], references: [id])
  lines    BtocOrderLine[]

  @@index([status])
  @@index([orderDate])
  @@index([customerId])
}

model BtocOrderLine {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  wooProductId  Int     // WooCommerce product or variation ID
  name          String
  sku           String?
  quantity      Int
  price         Float   // unit price
  total         Float   // line total
  size          String? // extracted from variation attributes
  color         String? // extracted from variation attributes
  createdAt     DateTime @default(now())

  order   BtocOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product BtocProduct? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model BtocSyncLog {
  id         String   @id @default(cuid())
  syncType   String   // CUSTOMERS, PRODUCTS, ORDERS, STOCK
  itemCount  Int
  errorCount Int      @default(0)
  errors     String?  // JSON
  duration   Int?     // ms
  syncedAt   DateTime @default(now())
}
