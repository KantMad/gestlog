generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Season {
  id         String   @id @default(cuid())
  name       String
  year       Int
  type       String   // "AH" or "PE"
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clients            ClientSeason[]
  supplierOrders     SupplierOrder[]
  clientOrders       ClientOrder[]
  catalogs           Catalog[]
  allocationSessions AllocationSession[]
  imports            ImportLog[]

  @@unique([year, type])
}

model Client {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  // Tailles que la boutique ne reçoit PAS en surplus (CSV, ex. "3XL,4XL"). Réglage GLOBAL
  // (pas par saison) : « cette boutique ne prend jamais de 4XL en trop ». Cf.
  // src/lib/allocation/surplus.ts pour les deux garde-fous (ne bloque que le surplus
  // au-delà du commandé ; levée si aucune autre boutique n'a commandé la taille).
  surplusExcludedSizes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons      ClientSeason[]
  clientOrders ClientOrder[]
  deliveries   Delivery[]
}

model ClientSeason {
  id                   String   @id @default(cuid())
  clientId             String
  seasonId             String
  ranking              Int      @default(5)
  maxReductionOrder    Float    @default(30.0)
  maxReductionLine     Float    @default(50.0)
  minDeliveryThreshold Int      @default(10)
  isActive             Boolean  @default(true)
  rotationScore        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([clientId, seasonId])
  @@index([seasonId])
  @@index([ranking])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierOrders     SupplierOrder[]
  receptions         SupplierReception[]
  supplierProductRefs SupplierProductRef[]
}

model Product {
  id          String   @id @default(cuid())
  reference   String
  color       String
  colorCode   String?
  colorLabel  String?  // nom/libellé de la couleur (TIO lng_content.text2, ex. "Chocolat") — pour la caisse
  externalId  String?  @unique // B2B product_id + color_id (e.g. "3119_53")
  sizeScale   String   // "XS,S,M,L,XL,XXL"
  category    String?  // catégorie BtoB (ex: "Pantalon")
  subCategory String?  // sous-catégorie BtoB (ex: "Pantalon 5 poches")
  label       String?  // désignation produit (TIO label_fr) — pour la création caisse
  salePrice   Float?   // prix de vente public (TIO prices[catalogue 209].min_retail_price)
  costPrice   Float?   // prix de gros / coût (TIO prices[catalogue 209].min_price)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplierOrderLines SupplierOrderLine[]
  clientOrderLines   ClientOrderLine[]
  receptionLines     ReceptionLine[]
  stockEntries       StockEntry[]
  allocationLines    AllocationLine[]
  deliveryLines      DeliveryLine[]
  shipmentSamples    ShipmentSample[]

  @@unique([reference, color])
  @@index([reference])
  @@index([externalId])
}

// Équivalence de code couleur entre les FICHIERS (commandes clients/fournisseurs,
// réceptions — ex. Texas « SSS ») et le RÉFÉRENTIEL TIO (ex. « 000 »).
// À l'import, un produit introuvable en `sourceCode` est recherché en `targetCode` ; s'il
// existe, il est **re-clé** en `sourceCode` (Product + ProductSizeEan) → on affiche partout
// le code des commandes tout en conservant EAN, grille de tailles et historique.
// Portée volontairement PRUDENTE : seules les références réellement rencontrées en
// `sourceCode` à l'import basculent.
model ColorEquivalence {
  id         String   @id @default(cuid())
  sourceCode String   // code présent dans les fichiers = code AFFICHÉ (ex. "SSS")
  targetCode String   // code du référentiel TIO à aller chercher (ex. "000")
  label      String?  // libellé couleur à appliquer lors de la bascule (ex. "Sans")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceCode, targetCode])
  @@index([sourceCode])
}

model ProductSizeEan {
  id        String @id @default(cuid())
  reference String
  color     String
  size      String
  ean       String @unique

  @@unique([reference, color, size])
  @@index([reference, color])
}

// Type de taille (ex: "A" = Standard Femme)
model SizeType {
  id        String   @id @default(cuid())
  code      String   @unique // ex: "A", "B", "C"
  label     String?  // ex: "Standard Femme"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings SizeTypeMapping[]
}

// Mapping : type de taille → numéro de taille → valeur taille
// Ex: type "A", position 1 → "XS" ; type "A", position 2 → "S" ; etc.
model SizeTypeMapping {
  id           String @id @default(cuid())
  sizeTypeId   String
  position     Int    // numéro de taille (1, 2, 3, 4...)
  sizeName     String // valeur taille ("XS", "S", "M", "L"...)

  sizeType SizeType @relation(fields: [sizeTypeId], references: [id], onDelete: Cascade)

  @@unique([sizeTypeId, position])
  @@unique([sizeTypeId, sizeName])
  @@index([sizeTypeId])
}

// Correspondance fournisseur ↔ référence produit
model SupplierProductRef {
  id           String   @id @default(cuid())
  supplierId   String
  reference    String
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, reference])
  @@index([reference])
}

model SupplierOrder {
  id          String    @id @default(cuid())
  orderNumber String
  seasonId    String
  supplierId  String
  orderDate   DateTime?
  status      String    @default("EN_ATTENTE") // EN_ATTENTE, PARTIEL, COMPLET, SOLDE
  tioSeason   String?   // code saison LU DANS LE FICHIER commande fournisseur (colonne « Saison » : W26, S27…), distinct de seasonId GestLog — sert à l'export réceptions
  importLogId String?   // import ayant (dernier) créé/mis à jour cette commande → suppression
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season     Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines      SupplierOrderLine[]
  receptions SupplierReception[]

  @@unique([orderNumber, seasonId])
  @@index([seasonId])
  @@index([supplierId])
  @@index([importLogId])
}

model SupplierOrderLine {
  id               String   @id @default(cuid())
  supplierOrderId  String
  productId        String
  quantitiesBySize String   // JSON: {"S":10,"M":20}
  totalQuantity    Int
  createdAt        DateTime @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierOrderId, productId])
}

model SupplierReception {
  id              String   @id @default(cuid())
  receptionNumber String
  supplierOrderId String
  supplierId      String
  importLogId     String?  // import ayant créé cette réception → suppression d'import
  lastEditedBy    String?  // nom de l'utilisateur ayant corrigé la réception (audit)
  lastEditedAt    DateTime? // date de la dernière correction manuelle
  receptionDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines         ReceptionLine[]
  samples       ShipmentSample[]

  @@index([supplierOrderId])
  @@index([importLogId])
}

model ReceptionLine {
  id                  String   @id @default(cuid())
  supplierReceptionId String
  productId           String
  quantitiesBySize    String   // JSON
  totalQuantity       Int
  createdAt           DateTime @default(now())

  supplierReception SupplierReception @relation(fields: [supplierReceptionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Pièces PRÉLEVÉES sur une réception pour le contrôle qualité du siège (« shipment
// samples »). Elles ne seront JAMAIS livrées : elles sont retirées du DISPONIBLE à la
// répartition. La réception, elle, reste inchangée (c'est un fait physique : ce que le
// fournisseur a livré) → la comparaison commande/réception n'est pas faussée.
// La saison vient de la réception (supplierOrder.seasonId).
model ShipmentSample {
  id                  String   @id @default(cuid())
  supplierReceptionId String
  productId           String
  size                String
  quantity            Int
  notes               String?
  createdBy           String? // nom de l'utilisateur ayant prélevé (audit)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  supplierReception SupplierReception @relation(fields: [supplierReceptionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Un seul prélèvement par (réception, produit, taille) — on cumule via la quantité.
  @@unique([supplierReceptionId, productId, size])
  @@index([supplierReceptionId])
  @@index([productId])
}

model Catalog {
  id        String   @id @default(cuid())
  name      String   @unique
  seasonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clientOrders ClientOrder[]

  @@index([seasonId])
}

model ClientOrder {
  id              String    @id @default(cuid())
  orderNumber     String
  seasonId        String
  clientId        String
  catalogId       String?
  orderDate       DateTime?
  source          String    @default("TIO") // TIO (prise de commande, archive) | TEXAS (ERP, vérité)
  orderType       String    @default("COMMANDE") // COMMANDE or VSS
  status          String    @default("EN_COURS") // EN_COURS, VALIDEE, SOLDEE, ANNULEE
  deliveryWindow  String?   // ex: "S22-S26", fenêtre de livraison
  paymentStatus   String    @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REFUSE
  tioOrderNumber  String?   // Take In Order reference number
  deliveryDateStart DateTime?
  deliveryDateEnd   DateTime?
  totalAmount     Float?    // montant total commande
  importLogId     String?   // import ayant (dernier) créé/mis à jour cette commande → suppression
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  season  Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalog Catalog?        @relation(fields: [catalogId], references: [id])
  lines   ClientOrderLine[]

  @@unique([orderNumber, seasonId])
  @@index([seasonId])
  @@index([clientId])
  @@index([catalogId])
  @@index([status])
  @@index([importLogId])
  @@index([seasonId, source])
}

model ClientOrderLine {
  id               String   @id @default(cuid())
  clientOrderId    String
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  amount           Float    @default(0) // CA NET de la ligne (€), réparti depuis le total commande TIO
  category         String?  // catégorie produit
  sizeTypeCode     String?  // code du type de taille (lien vers SizeType)
  // Pièces SOLDÉES (ne seront jamais livrées) : retirées du compte "à livrer".
  // JSON { taille: qté annulée }. Trace conservée (qui/quand).
  cancelledBySize  String   @default("{}")
  cancelledTotal   Int      @default(0)
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime @default(now())

  clientOrder ClientOrder @relation(fields: [clientOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientOrderId, productId])
}

model StockEntry {
  id               String   @id @default(cuid())
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  importLogId      String?  // import ayant créé cette entrée de stock → suppression d'import
  importDate       DateTime @default(now())
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([importLogId])
}

model AllocationSession {
  id          String   @id @default(cuid())
  seasonId    String
  sessionDate DateTime @default(now())
  status      String   @default("SIMULATION") // SIMULATION, VALIDATED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season     Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  lines      AllocationLine[]
  deliveries Delivery[]

  @@index([seasonId])
  @@index([status])
}

model AllocationLine {
  id                  String   @id @default(cuid())
  allocationSessionId String
  clientOrderId       String?
  productId           String
  clientId            String?
  originalBySize      String   // JSON
  allocatedBySize     String   // JSON
  reducedBySize       String   // JSON
  reductionReason     String
  status              String   @default("LIVRABLE") // LIVRABLE, EN_ATTENTE, ANNULE
  isManualAdjustment  Boolean  @default(false)
  createdAt           DateTime @default(now())

  allocationSession AllocationSession @relation(fields: [allocationSessionId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([allocationSessionId])
  @@index([productId])
}

model ShipmentGroup {
  id          String   @id @default(cuid())
  name        String   // ex: "PAMAZO S22"
  carrier     String?  // transporteur
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries Delivery[]
}

model Delivery {
  id                  String    @id @default(cuid())
  deliveryNumber      Int
  clientId            String
  clientOrderId       String?
  allocationSessionId String?
  shipmentGroupId     String?
  status              String    @default("PLANIFIEE") // PLANIFIEE, EN_PREPARATION, ENVOYEE_DEPOT, VALIDEE_DEPOT, EXPEDIEE
  colorCode           String
  eanExportGenerated  Boolean   @default(false)
  // Depot workflow fields
  nbColis             Int?
  nbPieces            Int?
  blNumber            String?   // numéro BL
  carrier             String?   // transporteur
  depotStatus         String?   // EN_ATTENTE, RECU, VALIDE, ANOMALIE
  comment             String?   // commentaire libre
  sentToDepotAt       DateTime?
  validatedAt         DateTime?
  shippedAt           DateTime?
  // Intégration CaissePro : envoi de la livraison validée → réception de stock caisse.
  caisseSyncStatus    String?   // SENT, ALREADY, FAILED, SKIPPED (null = pas encore envoyé)
  caisseSyncAt        DateTime?
  caisseSyncMatched   Int?      // nb d'EAN reconnus par le catalogue caisse
  caisseSyncInfo      String?   // EAN inconnus (JSON) ou message d'erreur
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  allocationSession AllocationSession?  @relation(fields: [allocationSessionId], references: [id])
  shipmentGroup     ShipmentGroup?      @relation(fields: [shipmentGroupId], references: [id])
  lines             DeliveryLine[]
  eanExports        EanExport[]

  @@index([clientId])
  @@index([status])
  @@index([shipmentGroupId])
}

model DeliveryLine {
  id               String   @id @default(cuid())
  deliveryId       String
  productId        String
  quantitiesBySize String   // JSON
  totalQuantity    Int
  createdAt        DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model EanExport {
  id          String   @id @default(cuid())
  deliveryId  String
  fileName    String
  exportData  String   // JSON array
  generatedAt DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model ImportLog {
  id         String   @id @default(cuid())
  seasonId   String
  importType String   // CLIENT_ORDER, SUPPLIER_ORDER, RECEPTION, STOCK, SIZE_TYPE, SUPPLIER_REF, EAN
  fileName   String
  rowCount   Int
  errorCount Int      @default(0)
  errors     String?  // JSON
  importedAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  role         String   @default("USER") // ADMIN or USER
  isActive     Boolean  @default(true)
  screenAccess String?  // JSON array of allowed screen keys; null = all screens
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Tentatives de connexion — anti-brute-force par IP (fenêtre glissante).
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// ─── BtoC (WooCommerce) — Données séparées du BtoB ──────────

model BtocCustomer {
  id            String   @id @default(cuid())
  wooId         Int      @unique  // WooCommerce customer ID
  email         String
  firstName     String
  lastName      String
  company       String?
  phone         String?
  billingPostcode String?
  billingCity   String?
  billingCountry String?
  shippingCity  String?
  shippingCountry String?
  totalSpent    Float    @default(0)
  ordersCount   Int      @default(0)
  // Statut VIP persistant : sert de garde anti-doublon pour ne déclencher le
  // scénario Brevo "client_vip" qu'UNE fois, au franchissement du seuil.
  // Recalculé par /api/sync/btoc/vip-recompute (jamais par la sync customers,
  // dont les total_spent/orders_count de l'API WooCommerce REST valent 0).
  isVip         Boolean  @default(false)
  vipSince      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders BtocOrder[]

  @@index([email])
}

model BtocProduct {
  id            String   @id @default(cuid())
  wooId         Int      @unique  // WooCommerce product ID
  sku           String?
  name          String
  type          String   @default("simple") // simple, variable, variation
  parentId      Int?     // parent product ID for variations
  status        String   @default("publish")
  price         Float?
  regularPrice  Float?
  salePrice     Float?
  stockQuantity Int?
  stockStatus   String?  // instock, outofstock, onbackorder
  category      String?  // main category name
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderLines BtocOrderLine[]

  @@index([sku])
  @@index([parentId])
}

model BtocOrder {
  id              String    @id @default(cuid())
  wooId           Int       @unique  // WooCommerce order ID
  orderNumber     String
  status          String    // pending, processing, on-hold, completed, cancelled, refunded, failed
  customerId      String?
  customerEmail   String?
  customerName    String?
  // Facturation (billing) — nom/prénom/adresse depuis WooCommerce billing.*
  billingFirstName String?
  billingLastName  String?
  billingAddress1  String?
  billingPostcode  String?
  billingCity     String?
  billingCountry  String?   // code pays ISO (FR, BE…) depuis WooCommerce billing.country
  // Livraison (shipping) — nom/prénom/adresse depuis WooCommerce shipping.*
  shippingFirstName String?
  shippingLastName  String?
  shippingAddress1  String?
  shippingPostcode  String?
  shippingCity    String?
  shippingCountry String?   // code pays ISO depuis WooCommerce shipping.country
  total           Float
  totalRefunded   Float    @default(0) // montant remboursé (partiel ou total) — déduit du CA
  subtotal        Float?
  totalTax        Float?
  shippingTotal   Float?
  discountTotal   Float?
  paymentMethod   String?
  paymentTitle    String?
  currency        String   @default("EUR")
  itemCount       Int      @default(0)
  couponCodes     String?  // JSON array of coupon codes
  customerNote    String?
  orderDate       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer BtocCustomer? @relation(fields: [customerId], references: [id])
  lines    BtocOrderLine[]

  @@index([status])
  @@index([orderDate])
  @@index([customerId])
}

model BtocOrderLine {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  wooProductId  Int     // WooCommerce product or variation ID
  name          String
  sku           String?
  quantity      Int
  price         Float   // unit price
  total         Float   // line total
  size          String? // extracted from variation attributes
  color         String? // extracted from variation attributes
  createdAt     DateTime @default(now())

  order   BtocOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product BtocProduct? @relation(fields: [productId], references: [id])

  // Garde-fou anti-doublon : WooCommerce n'a qu'UNE ligne par variation dans une commande.
  // Empêche physiquement la réinsertion en double (cf. sync btoc/orders + code de dédup).
  // (sku NULL n'est pas contraint — Postgres traite les NULL comme distincts — mais le
  // dédoublonnage applicatif couvre ces rares lignes sans sku.)
  @@unique([orderId, wooProductId, sku])
  @@index([orderId])
  @@index([productId])
}

// Lignes de remboursement WooCommerce (depuis /orders/{id}/refunds).
// Quantité + montant remboursés par article — pour déduire les remboursements
// partiels des stats de quantité (tailles, best-sellers) et de CA par ligne.
// Rattaché à la commande par son wooId.
model BtocRefundLine {
  id         String   @id @default(cuid())
  orderWooId Int      // BtocOrder.wooId
  refundId   Int      // id du remboursement WC
  lineId     Int      // id de la ligne de remboursement
  sku        String?  // sku de la variation (réf-couleur-taille)
  name       String?
  quantity   Int      @default(0) // quantité remboursée (positive)
  total      Float    @default(0) // montant remboursé (positif)
  createdAt  DateTime @default(now())

  @@unique([refundId, lineId])
  @@index([orderWooId])
  @@index([sku])
}

model BtocSyncLog {
  id         String   @id @default(cuid())
  syncType   String   // CUSTOMERS, PRODUCTS, ORDERS, STOCK
  itemCount  Int
  errorCount Int      @default(0)
  errors     String?  // JSON
  duration   Int?     // ms
  syncedAt   DateTime @default(now())
}

// ─── Historique BtoC (import depuis un autre WooCommerce) ───────────────
// Données legacy importées par fichier (export xlsx ligne-à-ligne). Stockées
// à part de BtocOrder pour ne pas perturber la sync live ; les exports
// Top Clients / Best Sellers font l'UNION des deux sources.
model HistOrder {
  id            String   @id @default(cuid())
  source        String   @default("woo_legacy") // identifie la boutique source
  orderNumber   String
  orderDate     DateTime
  customerEmail String?
  firstName     String?
  lastName      String?
  phone         String?
  country       String?  // code pays livraison (pas de ville/CP dans l'export)
  total         Float    @default(0) // montant total de la commande
  createdAt     DateTime @default(now())

  lines HistOrderLine[]

  @@unique([source, orderNumber])
  @@index([customerEmail])
  @@index([orderDate])
}

model HistOrderLine {
  id          String   @id @default(cuid())
  histOrderId String
  reference   String?  // UGS parent (ou dérivé du UGS) — null si produit sans SKU
  sku         String?  // UGS complet
  productName String?
  category    String?
  quantity    Int      @default(0)
  price       Float    @default(0) // prix unitaire
  lineTotal   Float    @default(0) // price * quantity
  createdAt   DateTime @default(now())

  order HistOrder @relation(fields: [histOrderId], references: [id], onDelete: Cascade)

  @@index([histOrderId])
  @@index([reference])
}

// ─── Documents entrepôt (BL / FAC importés du FTP) ──────────────────────
// Bons de Livraison et Factures déposés par l'entrepôt (export TexasWin) sur
// le FTP (/in/EAN/*.xlsx). Mêmes 78 colonnes pour BL et FAC ; on unifie via
// docType. Sert à la réconciliation des livraisons par client B2B.
// Clés de jointure outil : reference→Product.reference, ean→ProductSizeEan,
// clientCode→Client.code.
model WarehouseDocument {
  id             String   @id @default(cuid())
  source         String   @default("warehouse_ftp")
  docType        String   // "BL" (bon de livraison) ou "FAC" (facture)
  documentNumber String   // "N° Document" (ex: 137391)
  tioOrderNumber String?  // n° commande TIO extrait du nom de fichier (IS-xxx) — lien vers ClientOrder.orderNumber
  season         String?  // "Saison Document" (ex: W25)
  clientCode     String?  // "Code Client" → Client.code
  clientName     String?  // "Raison sociale Client"
  brandLabel     String?  // "Libellé marque" (ex: MCS)
  documentDate   DateTime? // BL: Date livraison — FAC: Date facture
  secondaryDate  DateTime? // BL: Date préparation — FAC: Date valeur
  documentTotal  Float?   // "Prix du Document"
  fileName       String   // nom du xlsx source (/in/EAN) — "" si document connu uniquement par son PDF
  pdfFileName    String?  // nom du PDF correspondant dans /in/PDF (consultable)
  hasLines       Boolean  @default(true) // false = document de référence (PDF seul, sans lignes détaillées)
  totalQuantity  Int      @default(0)
  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines WarehouseDocumentLine[]

  @@unique([source, docType, documentNumber])
  @@index([clientCode])
  @@index([docType])
  @@index([documentDate])
  @@index([tioOrderNumber])
}

model WarehouseDocumentLine {
  id           String  @id @default(cuid())
  documentId   String
  lineNo       String? // "N° Ligne"
  reference    String? // "Code Produit Fini" → Product.reference
  productLabel String? // "Libellé 1 Produit Fini"
  colorCode    String? // "Code Coloris"
  colorLabel   String? // "Libellé Coloris"
  size         String? // "Taille"
  ean          String? // "Code Barre" → ProductSizeEan.ean
  quantity     Int     @default(0) // "Qté"
  unitPrice    Float   @default(0) // "Prix Unitaire" (Pu) — renseigné pour les FAC
  amount       Float   @default(0) // "Montant HT" de la ligne — renseigné pour les FAC
  parcelNo     String? // "N° Colis"
  location     String? // "Code Emplacement"
  statFamily   String? // "Libellé famille statistique"
  statSubFamily String? // "Libellé sous famille statistique"
  orderRef     String? // "Référence Commande"
  rawData      String? // ligne brute complète (JSON) — on garde tout
  createdAt    DateTime @default(now())

  document WarehouseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([reference])
  @@index([ean])
}
